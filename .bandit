[bandit]
# Exclude virtual environments and third-party/generated code.
exclude = .venv,venv,site-packages,node_modules,__pycache__

# Baseline exceptions for legitimate patterns:
# B101 assert usage is required by pytest.
# B104 binding to 0.0.0.0 is legitimate for containerized services.
# B603/B607 subprocess patterns are used in e2e tests.
# B108 temp paths appear in test fixtures.
# B105/B106 hardcoded password findings are often test/config false positives.
# B110/B112 try/except cleanup patterns are common in tests.
# B311 random is used for test data selection, not cryptography.
# B404 subprocess import is informational in this repo.
# B608 SQL strings are used with trusted local schema/test data.
skips = B101,B104,B603,B607,B108,B105,B106,B112,B110,B311,B404,B608
