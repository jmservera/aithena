# ──────────────────────────────────────────────────────────────────────────────
# Aithena — canonical environment configuration template
#
# Use this file as the single checked-in template for local development,
# production overrides, offline packages, and troubleshooting. For a manual
# setup, copy it to `.env` and keep the placeholder secrets only long enough
# to verify the stack starts:
#
#   cp .env.example .env
#   docker compose config
#   docker compose up -d
#
# For a real deployment, prefer the installer so secrets and the auth database
# are generated safely:
#
#   ./installer/run.sh
#
# The installer writes `.env`, creates the auth DB, and preserves existing
# secrets unless `--reset` is passed.
# ──────────────────────────────────────────────────────────────────────────────

# ── General paths, origins, and build metadata ───────────────────────────────
# Host path mounted as the document library. The repo-local default is safe for
# smoke tests; point it at your real library before indexing real content.
BOOKS_PATH=./volumes/booklibrary

# Compatibility alias still consumed by the installer and some docs/scripts.
BOOK_LIBRARY_PATH=./volumes/booklibrary

# Public browser origin served by nginx.
PUBLIC_ORIGIN=http://localhost

# Browser origins allowed by solr-search. Keep localhost:5173 for Vite UI work.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# Build metadata used by image labels, /version endpoints, and GHCR tags.
VERSION=2.5.1
GIT_COMMIT=unknown
BUILD_DATE=2026-06-13T14:54:18+00:00

# ── Authentication, admin bootstrap, and API safety ──────────────────────────
# Host directory bind-mounted into solr-search for the SQLite auth database.
AUTH_DB_DIR=./volumes/auth

# Container path for the SQLite auth database. Change only with compose mount changes.
AUTH_DB_PATH=/data/auth/users.db

# Installer-managed JWT secret. Replace via `./installer/run.sh` before real use.
AUTH_JWT_SECRET=generate-with-installer

# JWT lifetime accepted by solr-search (`24h`, `30m`, `7d`, ...).
AUTH_JWT_TTL=24h

# Cookie name used for browser auth sessions.
AUTH_COOKIE_NAME=aithena_auth

# Defense-in-depth API key for `/v1/admin/*`. Keep set in all non-test deployments.
ADMIN_API_KEY=generate-with-installer

# Bootstrap admin account written by the installer into the auth database.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=

# Kept for compatibility/documentation; auth should stay enabled outside isolated tests.
AUTH_ENABLED=true

# Global request limit for authenticated API traffic. Set `0` to disable all rate limiting.
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Upload-specific request limit. Leave blank to use the service default, or set `0`
# alongside RATE_LIMIT_REQUESTS_PER_MINUTE=0 when you want uploads unlimited too.
UPLOAD_RATE_LIMIT_REQUESTS_PER_MINUTE=10

# ── RabbitMQ credentials ──────────────────────────────────────────────────────
# Legacy broker credentials kept for backwards compatibility with installer output.
RABBITMQ_USER=aithena
RABBITMQ_PASS=generate-with-installer

# Per-service least-privilege credentials loaded by src/rabbitmq/init-definitions.sh.
RABBITMQ_LISTER_USER=lister
RABBITMQ_LISTER_PASS=generate-with-installer
RABBITMQ_INDEXER_USER=indexer
RABBITMQ_INDEXER_PASS=generate-with-installer
RABBITMQ_SEARCH_USER=search
RABBITMQ_SEARCH_PASS=generate-with-installer
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASS=generate-with-installer

# ── Embeddings runtime ────────────────────────────────────────────────────────
# CPU + torch is the portable default. GPU overlays override these automatically.
DEVICE=cpu
BACKEND=torch

# Source-build base image tag for docker-compose.yml local builds.
EMBEDDINGS_BASE_TAG=3.12-slim-multilingual-e5-base

# Prebuilt embeddings image tag used by production/offline and Intel OpenVINO overlay.
EMBEDDINGS_VERSION=2.5.1

# Stored-vector precision: `none`, `fp16`, or `int8`.
VECTOR_QUANTIZATION=none

# Search mode implementation: `hnsw` (default) or `hybrid-rerank`.
SEARCH_ARCHITECTURE=hnsw

# Explicit vector field overrides. Leave aligned with VECTOR_QUANTIZATION unless testing.
KNN_FIELD=embedding_v
BOOK_EMBEDDING_FIELD=embedding_v

# solr-search collections metadata database inside the container.
COLLECTIONS_DB_PATH=/data/collections/collections.db

# ── Solr auth, versioning, and topology ──────────────────────────────────────
# Admin credentials used by solr-init, Solr health checks, and nginx auth proxying.
SOLR_ADMIN_USER=solr_admin
SOLR_ADMIN_PASS=generate-with-installer

# Read-only credentials used by solr-search query traffic.
SOLR_READONLY_USER=solr_read
SOLR_READONLY_PASS=generate-with-installer

# Solr runtime selection. Use docker/compose.solr9.yml only for temporary rollback testing.
SOLR_VERSION=10
SOLR_BASE_IMAGE=solr:10

# Optional extra JVM/Solr flags appended on every Solr node.
SOLR_OPTS=

# Production overlay appends this into SOLR_OPTS; keep false unless you have a reason to change it.
SOLR_CLOUD_OVERSEER_ENABLED=false

# Installer/start.sh topology hint: `single-node` (dev) or `distributed` (3 Solr + 3 ZK).
SOLR_TOPOLOGY=single-node

# Initial `books` collection shape. Single-node defaults keep local startup lightweight.
SOLR_NUM_SHARDS=1
SOLR_REPLICATION_FACTOR=1

# ── Reverse proxy, SSL, and test overlays ────────────────────────────────────
# Required only with docker/compose.ssl.yml. Replace with your real FQDN for TLS.
NGINX_HOST=aithena.example.com

# Library path used only by docker/compose.e2e.yml.
E2E_LIBRARY_PATH=./volumes/e2e-booklibrary

# ── Notes ─────────────────────────────────────────────────────────────────────
# - Redis has no user-facing env vars in the current compose stack.
# - Internal service hostnames/ports stay fixed in Compose (`redis`, `rabbitmq`,
#   `solr`, `embeddings-server`, `tika`) and are not meant to be customized here.
# - `docker compose up` uses the distributed base stack unless you also pass an
#   overlay such as `docker/compose.single-node.yml` or use the installer-generated
#   `./start.sh`, which reads `SOLR_TOPOLOGY`.
